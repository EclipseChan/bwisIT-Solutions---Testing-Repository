# Copy to .env and fill in. .env is ignored by Git. Never commit real values.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=canteen_db
DB_USER=canteen_admin
DB_PASSWORD=change-me
# Avoid double quotes in DB_PASSWORD (Windows PowerShell mangles them).
# JWT_SECRET: at least 32 random characters
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters
